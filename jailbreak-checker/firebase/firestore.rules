rules_version = '2';

// The app only reads. Every write comes from the Cloud Function (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /brands/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /consoles/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /news/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /meta/status {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
