{
  "name": "jailbreak-checker-functions",
  "private": true,
  "description": "Hourly AI updater for the Jailbreak Checker app (Firebase Cloud Functions + Claude)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "copy-data": "node scripts/copy-data.mjs",
    "build": "npm run copy-data && tsc",
    "test": "npm run build && node --test lib/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions,firestore",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9"
  }
}
